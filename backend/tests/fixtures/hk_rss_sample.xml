<?xml version="1.0" encoding="UTF-8"?>
<!--
  历史样本快照（手工构造，脱敏）：模拟港股新闻源的 RSS 2.0 输出格式。
  用于 tests/test_replay_rss.py 的回放测试，验证 HKT 时区样本转换为 UTC 存储值的正确性。
  覆盖点：
    - item1: pubDate 带显式 +0800 偏移（RFC822 格式）
    - item2: dc:date 无时区偏移的裸时间戳，需按 market="hk" 默认落到 Asia/Shanghai(+08:00)，
             且本地时间跨过 UTC 日期边界（HKT 02:15 属于 UTC 前一日 18:15）
    - item3: 缺失发布时间字段（published_at 应解析为 None）
-->
<rss version="2.0" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>HK Market Wire (Sample)</title>
    <link>https://example-hk-wire.test/feed</link>
    <item>
      <title>港交所公布最新上市规则修订（示例）</title>
      <link>https://example-hk-wire.test/story/hkex-rule-update</link>
      <description><![CDATA[<p>港交所今日公布上市规则修订，示例摘要文本。</p>]]></description>
      <pubDate>Wed, 15 Jan 2025 09:30:00 +0800</pubDate>
    </item>
    <item>
      <title>腾讯控股回购公告（示例）</title>
      <link>https://example-hk-wire.test/story/tencent-buyback</link>
      <dc:date>2025-06-21T02:15:00</dc:date>
    </item>
    <item>
      <title>汇丰控股中期业绩预告（示例，无发布时间）</title>
      <link>https://example-hk-wire.test/story/hsbc-earnings-preview</link>
    </item>
  </channel>
</rss>
