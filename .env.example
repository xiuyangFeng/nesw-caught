# 复制为 .env 使用（Makefile 从仓库根目录启动，pydantic-settings 读取仓库根目录的 .env）。
# 变量名不区分大小写、无前缀，完整清单见 backend/app/core/config.py。
# 本文件只列日志相关可调项（2026-08 日志系统重构引入/整理）。

# ---- 基础日志 ----
# 全局日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# plain：人类可读单行文本；json：单行 JSON（含 module/lineno/request_id/task_id/exc）
LOG_FORMAT=plain
# 是否写本地轮转文件（控制台输出始终开启）
LOG_FILE_ENABLED=true
# 缺省 backend/data/logs/backend.log（data/ 已被 gitignore）
#LOG_FILE_PATH=
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# ---- HTTP 访问日志（logger "app.access"）----
ACCESS_LOG_ENABLED=true
# 逗号分隔的路径前缀；默认排除健康检查轮询与 SSE 长连接噪声
ACCESS_LOG_EXCLUDE_PREFIXES=/api/health,/api/stream

# ---- 前端错误日志上报（POST /api/logs/frontend）----
FRONTEND_LOG_ENABLED=true
FRONTEND_LOG_MAX_ENTRIES_PER_REQUEST=20
FRONTEND_LOG_MAX_MESSAGE_LENGTH=2000
# 进程级滑动窗口限流（条/分钟）
FRONTEND_LOG_RATE_LIMIT_PER_MINUTE=120
